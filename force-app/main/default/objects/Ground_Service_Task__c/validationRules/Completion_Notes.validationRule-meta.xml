<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completion_Notes</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Task_Status__c,&quot;Completed&quot;),
ISBLANK(Completion_Notes__c)
)</errorConditionFormula>
    <errorDisplayField>Completion_Notes__c</errorDisplayField>
    <errorMessage>Completion Notes are required when the task is completed.</errorMessage>
</ValidationRule>
