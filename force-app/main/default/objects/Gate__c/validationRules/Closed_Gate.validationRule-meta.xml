<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closed_Gate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Status__c,&quot;Closed&quot;),
Boarding_Bridge_Available__c
)</errorConditionFormula>
    <errorDisplayField>Boarding_Bridge_Available__c</errorDisplayField>
    <errorMessage>Closed gates cannot have the boarding bridge available.</errorMessage>
</ValidationRule>
