<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Delay_Reason_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Status__c,&quot;Delayed&quot;),
ISBLANK(Delay_Reason__c)
)</errorConditionFormula>
    <errorDisplayField>Delay_Reason__c</errorDisplayField>
    <errorMessage>Delay Reason is mandatory when Flight Status is Delayed.</errorMessage>
</ValidationRule>
