<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Passenger_Count_Cannot_Be_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>Passenger_Count__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Passenger_Count__c</errorDisplayField>
    <errorMessage>Passenger Count cannot be negative.</errorMessage>
</ValidationRule>
