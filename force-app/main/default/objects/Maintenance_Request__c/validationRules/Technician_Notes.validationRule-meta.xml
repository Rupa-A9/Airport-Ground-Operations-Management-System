<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Technician_Notes</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Status__c,&quot;Completed&quot;),
ISBLANK(Technician_Notes__c)
)</errorConditionFormula>
    <errorDisplayField>Technician_Notes__c</errorDisplayField>
    <errorMessage>Technician Notes are mandatory before completing maintenance.</errorMessage>
</ValidationRule>
